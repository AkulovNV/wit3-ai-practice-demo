# Скопируйте в .env (скрипты scripts/up.* делают это сами). Значения ниже — только для локального стенда.

# Какие слои поднимать: ollama — модель в контейнере вместо нативной (медленнее, +7 GB образ),
# ci — Gitea + Actions runner (нужно с занятия 2; уберите, если мало памяти).
COMPOSE_PROFILES=ci

# Где gateway ищет Ollama. По умолчанию — нативная на хосте; с профилем ollama: http://ollama:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Опционально: облачная модель через тот же gateway (алиас "cloud")
ANTHROPIC_API_KEY=

LITELLM_MASTER_KEY=sk-master-wit3-local
# ключ менти (создаётся при setup): им ходят Open WebUI, IDE, агент, CI
LITELLM_USER_KEY=sk-mentee-wit3-local

LANGFUSE_PUBLIC_KEY=pk-lf-wit3
LANGFUSE_SECRET_KEY=sk-lf-wit3

GITEA_RUNNER_TOKEN=wit3RunnerRegistrationToken0000000000001
